package="itdoku"
version="@VERSION@"
os_min_ver="7.0-40000"
displayname="IT-Dokumentation"
description="IT-Dokumentation pro Kunde – schlanke Alternative zu IT Glue: Standorte, Ansprechpartner, Geräte, Lizenzen, Netzwerkplan und Zugangsdaten in einem verschlüsselten Tresor. Die Daten bleiben auf der eigenen NAS. Single Sign-on für DSM-Benutzer, nächtliche Datensicherung, Änderungsprotokoll."
description_ger="IT-Dokumentation pro Kunde – schlanke Alternative zu IT Glue: Standorte, Ansprechpartner, Geräte, Lizenzen, Netzwerkplan und Zugangsdaten in einem verschlüsselten Tresor. Die Daten bleiben auf der eigenen NAS. Single Sign-on für DSM-Benutzer, nächtliche Datensicherung, Änderungsprotokoll."
description_enu="Per-customer IT documentation – a lean IT Glue alternative: sites, contacts, devices, licenses, network plan and credentials in an encrypted vault, stored on your own NAS. DSM single sign-on, nightly backups, audit log (German UI)."
arch="noarch"
maintainer="rinkelzz"
maintainer_url="https://github.com/rinkelzz/it-doku"
distributor="rinkelzz"
distributor_url="https://github.com/rinkelzz/it-doku"
support_url="https://github.com/rinkelzz/it-doku/issues"
thirdparty="yes"
beta="no"
startable="yes"
ctl_stop="yes"
silent_upgrade="yes"
dsmuidir="ui"
dsmappname="SYNO.SDS.ITDoku.Application"
