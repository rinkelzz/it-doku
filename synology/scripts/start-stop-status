
# --- start-stop-status: wird von DSM beim Starten/Stoppen/Statusabfrage aufgerufen

is_running() {
    [ -f "${PIDFILE}" ] && kill -0 "$(cat "${PIDFILE}")" 2>/dev/null
}

start_daemon() {
    is_running && return 0
    set -- $(find_python)
    PY="$1"; TAG="$2"
    if [ -z "$PY" ]; then
        tell "Kein passendes Python gefunden (3.8 bis 3.13). Bitte im Paket-Zentrum „Python 3.9“ installieren."
        return 1
    fi
    [ -f "${CONFIG}" ] && . "${CONFIG}"
    export ITD_DATA_DIR="${PKGVAR}"
    export ITD_PORT="${ITD_PORT:-8780}"
    if ! port_free "$PY" "${ITD_PORT}"; then
        tell "Port ${ITD_PORT} ist schon belegt – die IT-Dokumentation kann nicht starten. Am einfachsten: Paket deinstallieren und mit einem anderen Port neu installieren (der Assistent fragt danach). Alternativ ITD_PORT in /var/packages/itdoku/var/config.env ändern."
        return 1
    fi
    export ITD_HOST="${ITD_HOST:-0.0.0.0}"
    export ITD_PUBLIC_URL ITD_ROOT_PATH ITD_COOKIE_SECURE ITD_TIMEZONE
    export ITD_UI_DIR="${PKGDEST}/ui"
    export ITD_CONFIG_FILE="${CONFIG}"
    PYTHONPATH="$(lib_path "$PY" "$TAG")"
    if [ -z "$PYTHONPATH" ]; then
        tell "Für Python ${TAG} auf $(cpu_name "$PY") liegen keine Bibliotheken im Paket."
        return 1
    fi
    export PYTHONPATH
    export PYTHONDONTWRITEBYTECODE=1
    # Für ui/app.cgi (DSM-Fenster): welches Python die Weiterleitung nutzen soll
    echo "${PY}" > "${PKGDEST}/.python" 2>/dev/null && chmod 644 "${PKGDEST}/.python" 2>/dev/null
    log "Starte mit ${PY} (${TAG}, $(cpu_name "$PY")) auf Port ${ITD_PORT}"
    cd "${PKGDEST}" || return 1
    nohup "${PY}" -m app.main >> "${LOGFILE}" 2>&1 &
    echo $! > "${PIDFILE}"
    # kurz warten, ob der Prozess stehen bleibt
    i=0
    while [ $i -lt 10 ]; do
        sleep 1
        if ! is_running; then
            tell "Die IT-Dokumentation hat sich direkt wieder beendet. Letzte Meldungen:"
            [ -n "${SYNOPKG_TEMP_LOGFILE:-}" ] && tail -n 5 "${LOGFILE}" >> "${SYNOPKG_TEMP_LOGFILE}"
            return 1
        fi
        i=$((i + 1))
        [ $i -ge 2 ] && return 0
    done
}

stop_daemon() {
    if is_running; then
        kill "$(cat "${PIDFILE}")" 2>/dev/null
        i=0
        while is_running && [ $i -lt 15 ]; do sleep 1; i=$((i + 1)); done
        is_running && kill -9 "$(cat "${PIDFILE}")" 2>/dev/null
        log "Gestoppt"
    fi
    rm -f "${PIDFILE}"
}

case "$1" in
    start)  start_daemon; exit $? ;;
    stop)   stop_daemon; exit 0 ;;
    status) is_running && exit 0 || exit 3 ;;
    log)    echo "${LOGFILE}"; exit 0 ;;
    *)      exit 1 ;;
esac
