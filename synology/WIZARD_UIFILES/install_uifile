[
    {
        "step_title": "IT-Dokumentation einrichten",
        "items": [
            {
                "type": "password",
                "desc": "Passwort für den Benutzer <b>admin</b> der IT-Dokumentation (mindestens 8 Zeichen). Das ist unabhängig von deinem DSM-Konto – DSM-Administratoren werden im DSM-Fenster auch ohne Passwort angemeldet. Die Zugangsdaten liegen später zusätzlich in einem Tresor mit eigenem Passwort.",
                "subitems": [
                    {
                        "key": "wizard_admin_password",
                        "desc": "Admin-Passwort",
                        "validator": {
                            "allowBlank": false,
                            "minLength": 8
                        }
                    }
                ]
            },
            {
                "type": "textfield",
                "desc": "Name der Firma, die hier dokumentiert wird (Kopfzeile, Anmeldung, Berichte) (optional, später änderbar – dort auch das Logo).",
                "subitems": [
                    {
                        "key": "wizard_company",
                        "desc": "Firmenname",
                        "emptyText": "z. B. Muster GmbH",
                        "validator": {
                            "allowBlank": true,
                            "maxLength": 80
                        }
                    }
                ]
            },
            {
                "type": "textfield",
                "desc": "Port, auf dem die IT-Dokumentation im Heimnetz läuft. Nur ändern, wenn 8780 schon belegt ist – später unter Verwaltung → System änderbar.",
                "subitems": [
                    {
                        "key": "wizard_port",
                        "desc": "Port",
                        "defaultValue": "8780",
                        "validator": {
                            "allowBlank": false,
                            "regex": {
                                "expr": "/^(102[5-9]|10[3-9][0-9]|1[1-9][0-9]{2}|[2-9][0-9]{3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$/",
                                "errorText": "Bitte eine Zahl zwischen 1025 und 65535"
                            }
                        }
                    }
                ]
            }
        ]
    }
]
